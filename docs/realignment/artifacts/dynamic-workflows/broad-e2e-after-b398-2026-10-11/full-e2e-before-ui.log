        box = menu.bounding_box()
        assert 0 <= box["x"] and box["x"] + box["width"] <= width + 1
        assert 0 <= box["y"] and box["y"] + box["height"] <= height + 1
        menu.get_by_text("model calls and reads still happen", exact=False).wait_for()
