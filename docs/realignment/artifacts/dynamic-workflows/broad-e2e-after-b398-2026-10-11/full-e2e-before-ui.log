        page.on('pageerror', lambda error: errors.append(str(error)))
        out = Path(__file__).resolve().parents[2]/'docs/realignment/artifacts/fact-memory'
        out.mkdir(parents=True, exist_ok=True)
        try:
            page.goto(base+'/#/chat/'+bot.name)
