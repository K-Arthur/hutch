  "residual_gaps": [
    {
      "id": "usage-no-error-state",
      "files": [
        "src/hutch/server/pages_usage.py:20-66",
        "src/hutch/server/templates/usage.html:7-77"
      ],
      "summary": "/usage has no server-rendered error banner or retry action: usage.html renders only empty/list states and pages_usage.py sets no error context, so failures fall through to the generic error page."
    },
    {
      "id": "usage-empty-no-cta",
      "files": [
        "src/hutch/server/templates/usage.html:51"
      ],
      "summary": "The /usage empty state ('No model calls in the last 30 days.') has no first-run call to action for connecting a provider or starting work."
    },
    {
      "id": "models-empty-no-cta",
      "files": [
        "src/hutch/server/templates/models.html:25",
        "src/hutch/server/templates/models.html:52-54"
      ],
      "summary": "The /models empty state ('No runtimes detected.' plus 'Start Ollama ...') is hint text only; no button-level call to action for the missing runtime."
    },
    {
      "id": "approvals-empty-no-cta",
      "files": [
        "src/hutch/server/static/app.js:7946-7953",
        "src/hutch/server/static/app.js:8083-8133"
      ],
      "summary": "The approvals empty state ('No pending approvals.') has no call to action; data-API errors are handled inline by the needs-you drawer with its own Retry button rather than by the route error boundary."
    },
    {
      "id": "approvals-retry-loses-route",
      "files": [
        "src/hutch/server/static/app.js:7888-7897",
        "src/hutch/server/static/app.js:2287-2313"
      ],
      "summary": "renderApprovals replaces the hash with #/chat before loading; when the shell then fails, the route error boundary's Try again re-runs the #/chat route, so retry recovers the chat studio rather than the approvals drawer."
    },
    {
      "id": "bots-empty-route-collapses",
      "files": [
        "src/hutch/server/static/app.js:7291-7294",
        "src/hutch/server/static/app.js:7342-7347",
        "src/hutch/server/static/app.js:2388-2390"
      ],
      "summary": "GET /bots redirects to #/bots, but renderBots redirects to #/chat whenever fewer than ten assistants exist, so the fleet empty state and its 'Create your first assistant' button are unreachable on an empty store; the visible copy is the roster's 'No assistants yet \u2014 create one.'"
    },
    {
      "id": "connections-empty-hidden-until-detail",
      "files": [
        "src/hutch/server/static/connection-browser.js:31-32",
        "src/hutch/server/static/app.js:10192-10197"
      ],
      "summary": "The 'No connections configured.' state and its 'Connect a provider' button live behind the AI model providers detail: connection-browser.js hides #connection-management in the directory view, and the directory always renders the full connection catalog."
    },
    {
      "id": "form-post-origin-null",
      "files": [
        "src/hutch/server/security.py:314-318",
        "src/hutch/server/security.py:374-377",
        "src/hutch/server/security.py:428-435",
        "src/hutch/server/templates/models.html:112-124",
        "src/hutch/server/templates/base.html:34-38"
      ],
      "summary": "Plain server-rendered form POSTs are refused in Chromium: Referrer-Policy no-referrer makes Chromium submit with 'Origin: null', and SecurityMiddleware._same_origin rejects null even though Sec-Fetch-Site is same-origin. The /models flash error is exercised through a browser-context request carrying the page CSRF token, and the refused direct submit is recorded."
    }
  ],
  "deviations": [
    {
      "id": "deterministic-models-view",
      "summary": "The /models empty view is forced with a stub ModelsView (empty runtimes/rows/notes) via monkeypatch of hutch.server.pages_models.build_models_view, because host hardware and runtime probes inject non-deterministic notes and runtime rows."
    },
    {
      "id": "flash-error-via-context-request",
      "summary": "The /models flash error is produced by a POST through the page's browser-context request with the page CSRF token, because a direct Chromium form submit is refused at HEAD (see residual gap form-post-origin-null)."
    },
    {
      "id": "approvals-route-boundary-via-shell-api",
      "summary": "The approvals route error boundary is exercised by failing the studio-shell API (GET /api/bots), which the route requires before opening the drawer; the approvals data-API failure path is asserted separately as an inline drawer error."
    }
  ],
