{
  "$description": "hutch brand tokens — single source of truth. Primitive -> semantic -> component. Compiled to website/tokens.css by scripts/build_site_tokens.py. The app keeps its own :root mapping; changing values here requires regression checks on both surfaces (docs/design-system.md).",

  "color": {
    "$type": "color",
    "primitive": {
      "ink": {
        "950": { "$value": "#05070a" },
        "900": { "$value": "#080c12" },
        "850": { "$value": "#0a0e15" },
        "800": { "$value": "#10161f" },
        "750": { "$value": "#171f2b" },
        "700": { "$value": "#1d2735" },
        "well": { "$value": "#070a10" },
        "overlay": { "$value": "#0d1219" }
      },
      "paper": { "$value": "#f0f4f9" },
      "mist": { "$value": "#9daebf" },
      "faint": { "$value": "#7d8ea4" },
      "emerald": {
        "300": { "$value": "#6ee7b7" },
        "400": { "$value": "#34d399" },
        "600": { "$value": "#10b981" },
        "ink": { "$value": "#052e21" },
        "deep": { "$value": "#073d31" }
      },
      "blue": { "400": { "$value": "#60a5fa" } },
      "amber": { "400": { "$value": "#fbbf24" } },
      "red": { "400": { "$value": "#f87171" } },
      "white": { "a06": { "$value": "rgba(255,255,255,0.06)" }, "a10": { "$value": "rgba(255,255,255,0.10)" }, "a18": { "$value": "rgba(255,255,255,0.18)" }, "a08": { "$value": "rgba(255,255,255,0.08)" } }
    },
    "semantic": {
      "bg": { "$value": "{color.primitive.ink.950}" },
      "surface": { "$value": "{color.primitive.ink.850}" },
      "panel": { "$value": "{color.primitive.ink.800}" },
      "raised": { "$value": "{color.primitive.ink.750}" },
      "well": { "$value": "{color.primitive.ink.well}" },
      "sunken": { "$value": "{color.primitive.ink.900}" },
      "text": { "$value": "{color.primitive.paper}" },
      "text-2": { "$value": "{color.primitive.mist}" },
      "text-3": { "$value": "{color.primitive.faint}" },
      "brand": { "$value": "{color.primitive.emerald.400}" },
      "brand-strong": { "$value": "{color.primitive.emerald.300}" },
      "brand-deep": { "$value": "{color.primitive.emerald.600}" },
      "on-brand": { "$value": "{color.primitive.emerald.ink}" },
      "link": { "$value": "{color.primitive.emerald.400}" },
      "info": { "$value": "{color.primitive.blue.400}" },
      "success": { "$value": "{color.primitive.emerald.400}" },
      "warning": { "$value": "{color.primitive.amber.400}" },
      "danger": { "$value": "{color.primitive.red.400}" },
      "border": { "$value": "{color.primitive.white.a10}", "$extensions": { "site.decorative": true } },
      "border-strong": { "$value": "{color.primitive.white.a18}" },
      "border-soft": { "$value": "{color.primitive.white.a06}", "$extensions": { "site.decorative": true } },
      "ring-glass": { "$value": "{color.primitive.white.a08}", "$extensions": { "site.decorative": true } },
      "focus-ring": { "$value": "{color.primitive.emerald.400}" },
      "scrim-nav": { "$value": "rgba(5,7,10,0.94)" },
      "scrim-well": { "$value": "rgba(255,255,255,0.04)" }
    },
    "verify": {
      "$extensions": {
        "site.textPairs": [
          ["color.semantic.text", "color.semantic.bg"],
          ["color.semantic.text", "color.semantic.surface"],
          ["color.semantic.text", "color.semantic.panel"],
          ["color.semantic.text", "color.semantic.raised"],
          ["color.semantic.text", "color.semantic.well"],
          ["color.semantic.text-2", "color.semantic.bg"],
          ["color.semantic.text-2", "color.semantic.surface"],
          ["color.semantic.text-2", "color.semantic.raised"],
          ["color.semantic.text-3", "color.semantic.bg"],
          ["color.semantic.text-3", "color.semantic.surface"],
          ["color.semantic.brand", "color.semantic.bg"],
          ["color.semantic.brand", "color.semantic.well"],
          ["color.semantic.on-brand", "color.semantic.brand"],
          ["color.semantic.on-brand", "color.semantic.brand-deep"],
          ["color.semantic.info", "color.semantic.bg"],
          ["color.semantic.warning", "color.semantic.bg"],
          ["color.semantic.danger", "color.semantic.bg"]
        ]
      }
    }
  },

  "font": {
    "$type": "fontFamily",
    "display": { "$value": "\"Archivo\", ui-sans-serif, system-ui, \"Segoe UI\", sans-serif" },
    "body": { "$value": "{font.display}" },
    "mono": { "$value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", \"Fira Code\", Menlo, Consolas, monospace" }
  },

  "text": {
    "$type": "custom",
    "size-2xs": { "$value": "12px" },
    "size-xs": { "$value": "13px" },
    "size-sm": { "$value": "15px" },
    "size-base": { "$value": "17px" },
    "size-lg": { "$value": "19px" },
    "size-xl": { "$value": "clamp(22px, 2.4vw, 27px)" },
    "size-2xl": { "$value": "clamp(27px, 3.6vw, 40px)" },
    "size-3xl": { "$value": "clamp(34px, 5vw, 58px)" },
    "size-display": { "$value": "clamp(40px, 5.6vw, 66px)" },
    "size-poster": { "$value": "clamp(88px, 12.5vw, 260px)" },
    "lh-tight": { "$value": "1.04" },
    "lh-snug": { "$value": "1.16" },
    "lh-body": { "$value": "1.65" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },

  "size": {
    "$type": "dimension",
    "content": { "$value": "1160px" },
    "measure": { "$value": "62ch" },
    "nav": { "$value": "68px" },
    "target": { "$value": "44px" },
    "rail": { "$value": "2px" }
  },

  "radius": {
    "$type": "dimension",
    "control": { "$value": "0px" },
    "panel": { "$value": "8px" },
    "chip": { "$value": "100px" }
  },

  "motion": {
    "$type": "custom",
    "dur-fast": { "$value": "150ms" },
    "dur-base": { "$value": "240ms" },
    "dur-slow": { "$value": "400ms" },
    "dur-expressive": { "$value": "900ms" },
    "ease-standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "ease-expressive": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "reveal-shift": { "$value": "20px" }
  },

  "layer": {
    "$type": "number",
    "nav": { "$value": 100 },
    "dialog": { "$value": 200 },
    "live": { "$value": 210 }
  },

  "deprecated": {
    "$extensions": {
      "site.migration": {
        "--accent (site blue #52a8ff)": "--brand (#34d399): Oct-2026 blue rebase retired; brand lineage preserved per shared contract v2; blue kept only as semantic info role",
        "--bg-card rgba glass fills": "--surface/--panel solid values; universal translucency retired",
        "--radius-lg 16 / 24 glass containers": "--radius-panel 8px only; no large-radius marketing containers",
        "2.05s intro overlay": "removed; content visible immediately",
        "scripted approval demo": "removed; website screenshots now show the actual empty first-run application state",
        "pip install hutch CTA": "no public package exists; CTA must match verified access"
      }
    }
  }
}
