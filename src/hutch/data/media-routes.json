{
  "_readme": "One row per (provider, kind) media route. Read on 2026-11-06 from each vendor's own documentation (sources are listed per row); nothing here was exercised against a live account, so every buildable row is implemented-unverified. A row that is documented, blocked or retired carries no request and is never built. Field vocabulary is fixed by hutch.media.providers.route_spec and wire; placeholders are {prompt} {model} {model_app} {voice} {style} {seconds} {aspect_ratio} {uuid} {task_id} plus anything under defaults. A placeholder with no value drops its field.",
  "routes": {
    "xai-image": {
      "provider": "xai", "kind": "image", "protocol": "sync", "title": "xAI Grok Imagine image",
      "status": "implemented-unverified", "model": "grok-imagine-image-2.0",
      "credential": {"templates": ["xai"]},
      "request": {"method": "POST", "path": "/images/generations",
                  "body": {"model": "{model}", "prompt": "{prompt}", "n": 1,
                           "aspect_ratio": "{aspect_ratio}", "response_format": "b64_json"}},
      "response": {"kind": "json", "media": {"path": "data", "key": "b64_json"}, "encoding": "base64"},
      "limits": {"prompt_chars": 4000, "aspect_ratios": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]},
      "price": "xai-image",
      "notes": "Endpoint and model read from docs.x.ai; the field names aspect_ratio and response_format come from the OpenClaw xAI page because the xAI page does not show them.",
      "sources": [{"url": "https://docs.x.ai/docs/guides/image-generations", "read": "2026-11-06"},
                  {"url": "https://docs.openclaw.ai/providers/xai", "read": "2026-11-06"}]
    },
    "xai-video": {
      "provider": "xai", "kind": "video", "protocol": "task", "title": "xAI Grok Imagine video",
      "status": "implemented-unverified", "model": "grok-imagine-video",
      "credential": {"templates": ["xai"]},
      "request": {"method": "POST", "path": "/videos/generations",
                  "body": {"model": "{model}", "prompt": "{prompt}", "duration": "{seconds}",
                           "aspect_ratio": "{aspect_ratio}"}},
      "task": {"id_path": "request_id",
               "poll": {"method": "GET", "path": "/videos/{task_id}", "status_path": "status",
                        "running": ["pending", "processing"], "done": ["done"],
                        "failed": ["failed", "expired"], "error_path": "error"},
               "result": {"url_path": "video.url"}},
      "limits": {"prompt_chars": 4000, "seconds": {"min": 1, "max": 15, "default": 5},
                 "aspect_ratios": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"], "timeout_seconds": 60},
      "price": "xai-video",
      "notes": "Text-to-video uses the classic model; grok-imagine-video-1.5 is image-to-video only and is not offered. The vendor documents no cancel call, so cancel is reported unconfirmed. Result URL retention is not documented.",
      "sources": [{"url": "https://docs.x.ai/docs/guides/video-generations", "read": "2026-11-06"},
                  {"url": "https://docs.openclaw.ai/providers/xai", "read": "2026-11-06"}]
    },
    "xai-speech": {
      "provider": "xai", "kind": "audio", "protocol": "sync", "title": "xAI Grok text to speech",
      "status": "implemented-unverified", "model": "grok-tts",
      "credential": {"templates": ["xai"]},
      "request": {"method": "POST", "path": "/tts",
                  "body": {"text": "{prompt}", "voice_id": "{voice}",
                           "output_format": {"codec": "wav", "sample_rate": 24000}}},
      "response": {"kind": "bytes", "accept": ["audio/"]},
      "limits": {"prompt_chars": 4000, "voices": ["eve", "ara", "rex", "sal", "leo"]},
      "defaults": {"voice": "eve"},
      "price": "xai-speech",
      "notes": "Single-call endpoint returning raw audio. The vendor states no character limit; 4000 is Hutch's own bound. The model id is a label: the request names a voice, not a model.",
      "sources": [{"url": "https://docs.x.ai/developers/model-capabilities/audio/text-to-speech", "read": "2026-11-06"}]
    },
    "minimax-image": {
      "provider": "minimax", "kind": "image", "protocol": "sync", "title": "MiniMax image-01",
      "status": "implemented-unverified", "model": "image-01",
      "credential": {"templates": ["minimax"]},
      "request": {"method": "POST", "path": "/image_generation",
                  "body": {"model": "{model}", "prompt": "{prompt}", "aspect_ratio": "{aspect_ratio}",
                           "response_format": "base64", "n": 1}},
      "response": {"kind": "json", "media": {"path": "data.image_base64"}, "encoding": "base64",
                   "envelope": {"code_path": "base_resp.status_code", "ok": 0,
                                "message_path": "base_resp.status_msg", "refusal_codes": [1026]},
                   "refusal_when": {"path": "metadata.failed_count", "gt": 0,
                                    "reason": "MiniMax content safety blocked the image"}},
      "limits": {"prompt_chars": 1500, "aspect_ratios": ["1:1", "16:9", "4:3", "3:2", "2:3", "3:4", "9:16", "21:9"]},
      "price": "minimax-image",
      "notes": "HTTP 200 carries failures in base_resp; 1026 is sensitive content, 1008 insufficient balance. Use the international host (api.minimax.io); a key works only on its own region.",
      "sources": [{"url": "https://platform.minimax.io/docs/api-reference/image-generation-t2i", "read": "2026-11-06"}]
    },
    "minimax-speech": {
      "provider": "minimax", "kind": "audio", "protocol": "sync", "title": "MiniMax speech-2.8",
      "status": "implemented-unverified", "model": "speech-2.8-hd",
      "credential": {"templates": ["minimax"]},
      "request": {"method": "POST", "path": "/t2a_v2",
                  "body": {"model": "{model}", "text": "{prompt}", "stream": false,
                           "voice_setting": {"voice_id": "{voice}"},
                           "audio_setting": {"format": "wav", "sample_rate": 24000, "channel": 1},
                           "output_format": "hex"}},
      "response": {"kind": "json", "media": {"path": "data.audio"}, "encoding": "hex",
                   "envelope": {"code_path": "base_resp.status_code", "ok": 0,
                                "message_path": "base_resp.status_msg", "refusal_codes": [1026]}},
      "limits": {"prompt_chars": 4000},
      "defaults": {"voice": "English_expressive_narrator"},
      "price": "minimax-speech",
      "notes": "Text must be under 10,000 characters per the vendor; 4000 is Hutch's bound. Billed on usage_characters. Voice ids are a large catalogue and are not enumerated here.",
      "sources": [{"url": "https://platform.minimax.io/docs/api-reference/speech-t2a-http", "read": "2026-11-06"}]
    },
    "minimax-video": {
      "provider": "minimax", "kind": "video", "protocol": "task", "title": "MiniMax Hailuo video",
      "status": "documented", "model": "MiniMax-Hailuo-2.3",
      "credential": {"templates": ["minimax"]},
      "notes": "Create is read (POST /v1/video_generation returns task_id; failures in base_resp; 1026 is sensitive content). The query and file-retrieve pages were not in the fetched text, so the two-hop result is not built.",
      "sources": [{"url": "https://platform.minimax.io/docs/api-reference/video-generation-t2v", "read": "2026-11-06"}]
    },
    "google-image": {
      "provider": "google", "kind": "image", "protocol": "sync", "title": "Google Gemini image (Nano Banana)",
      "status": "implemented-unverified", "model": "gemini-nano-banana-2.1",
      "credential": {"templates": ["google-gemini"]},
      "auth": {"header": "x-goog-api-key", "scheme": ""},
      "headers": {"Api-Revision": "2026-05-20"},
      "request": {"method": "POST", "path": "/interactions",
                  "body": {"model": "{model}", "input": [{"type": "text", "text": "{prompt}"}],
                           "response_format": {"type": "image", "aspect_ratio": "{aspect_ratio}"}}},
      "response": {"kind": "json", "encoding": "base64",
                   "media": {"path": "steps.*.content.*", "where": {"type": "image"}, "pick": "last", "key": "data"}},
      "limits": {"prompt_chars": 4000, "aspect_ratios": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]},
      "price": "google-image",
      "notes": "Interactions API as shown in Google's current REST example. The docs read do not show a way to stop Google keeping the interaction; none is sent. A response with no image block is a failure, never an empty success. Safety-block shape is not documented on the page read.",
      "sources": [{"url": "https://ai.google.dev/gemini-api/docs/interactions/image-generation", "read": "2026-11-06"},
                  {"url": "https://aistudio.google.com/docs/pricing", "read": "2026-11-06"}]
    },
    "google-speech": {
      "provider": "google", "kind": "audio", "protocol": "sync", "title": "Google Gemini text to speech",
      "status": "implemented-unverified", "model": "gemini-3.8-flash-tts",
      "credential": {"templates": ["google-gemini"]},
      "auth": {"header": "x-goog-api-key", "scheme": ""},
      "headers": {"Api-Revision": "2026-05-20"},
      "request": {"method": "POST", "path": "/interactions",
                  "body": {"model": "{model}",
                           "input": [{"type": "user_input", "content": [{"type": "text", "text": "{prompt}"}]}],
                           "response_format": {"type": "audio"},
                           "generation_config": {"speech_config": [{"voice": "{voice}"}]}}},
      "response": {"kind": "json", "encoding": "base64",
                   "media": {"path": "steps.*.content.*", "where": {"type": "audio"}, "pick": "last", "key": "data"}},
      "limits": {"prompt_chars": 4000, "voices": ["Zephyr", "Puck", "Charon", "Kore", "Fenrir", "Leda", "Orus", "Aoede", "Callirrhoe", "Autonoe", "Enceladus", "Iapetus", "Umbriel", "Algieba", "Despina", "Erinome", "Algenib", "Rasalgethi", "Laomedeia", "Achernar", "Alnilam", "Schedar", "Gacrux", "Pulcherrima", "Achird", "Zubenelgenubi", "Vindemiatrix", "Sadachbia", "Sadaltager", "Sulafat"]},
      "defaults": {"voice": "Kore"},
      "price": "google-speech",
      "notes": "Unary output is a complete 24 kHz mono WAV. HTTP 200 with no audio block is a known preview failure (finishReason OTHER) that is still billed; it is reported as a failure and not retried. Style instructions are not sent on this route. Price rises on 2027-01-01.",
      "sources": [{"url": "https://ai.google.dev/gemini-api/docs/interactions/speech-generation", "read": "2026-11-06"},
                  {"url": "https://aistudio.google.com/docs/pricing", "read": "2026-11-06"}]
    },
    "google-omni-video": {
      "provider": "google", "kind": "video", "protocol": "task", "title": "Google Gemini Omni Flash video",
      "status": "documented", "model": "gemini-omni-1.2-flash",
      "credential": {"templates": ["google-gemini"]},
      "notes": "Replaces the Veo preview models; 3 to 15 seconds with native audio through the Interactions API, billed per output token. The long-running request shape was not read.",
      "sources": [{"url": "https://aistudio.google.com/docs/video", "read": "2026-11-06"}]
    },
    "google-veo": {
      "provider": "google", "kind": "video", "protocol": "task", "title": "Google Veo 3.1 preview",
      "status": "retired", "retired_on": "2026-10-22", "model": "veo-3.1-generate-preview",
      "notes": "The Veo preview models were shut down on 2026-10-22; Google points to Gemini Omni Flash.",
      "sources": [{"url": "https://aistudio.google.com/docs/video", "read": "2026-11-06"}]
    },
    "openai-image": {
      "provider": "openai", "kind": "image", "protocol": "adapter", "adapter": "openai-images",
      "title": "OpenAI GPT Image", "status": "implemented-unverified", "model": "gpt-image-1-mini",
      "credential": {"templates": ["openai-api"]},
      "limits": {"prompt_chars": 4000},
      "price": "openai-image",
      "notes": "Built on the OpenAI SDK with the model-family rules in openai_images.py. GPT Image models reject response_format; moderation_blocked is a refusal. Organization verification may be required for some models. The guide and the pricing page name different current ids, so the model is data and the key's own model list is authoritative.",
      "sources": [{"url": "https://developers.openai.com/api/docs/guides/image-generation", "read": "2026-11-06"},
                  {"url": "https://developers.openai.com/api/docs/pricing", "read": "2026-11-06"}]
    },
    "openai-speech": {
      "provider": "openai", "kind": "audio", "protocol": "sync", "title": "OpenAI text to speech",
      "status": "implemented-unverified", "model": "gpt-4o-mini-tts",
      "credential": {"templates": ["openai-api"]},
      "request": {"method": "POST", "path": "/audio/speech",
                  "body": {"model": "{model}", "input": "{prompt}", "voice": "{voice}",
                           "response_format": "wav", "instructions": "{style}"}},
      "response": {"kind": "bytes", "accept": ["audio/"]},
      "limits": {"prompt_chars": 4000, "style": true},
      "defaults": {"voice": "alloy"},
      "price": "openai-speech",
      "notes": "Model and price read on the pricing page; the endpoint shape is the long-standing audio/speech call and was not re-read this session.",
      "sources": [{"url": "https://developers.openai.com/api/docs/pricing", "read": "2026-11-06"}]
    },
    "openai-video": {
      "provider": "openai", "kind": "video", "protocol": "task", "title": "OpenAI Sora 2",
      "status": "retired", "retired_on": "2026-09-24", "model": "sora-2",
      "notes": "The Videos API and the Sora 2 models were shut down on 2026-09-24 with no replacement.",
      "sources": [{"url": "https://developers.openai.com/api/docs/guides/video-generation", "read": "2026-11-06"}]
    },
    "fal-image": {
      "provider": "fal", "kind": "image", "protocol": "task", "title": "fal image (queue)",
      "status": "implemented-unverified", "model": "fal-ai/flux/dev",
      "credential": {"env": "FAL_KEY", "base_url": "https://queue.fal.run"},
      "auth": {"header": "Authorization", "scheme": "Key"},
      "headers": {"X-Fal-No-Retry": "1"},
      "request": {"method": "POST", "path": "/{model}", "body": {"prompt": "{prompt}", "num_images": 1}},
      "task": {"id_path": "request_id",
               "poll": {"method": "GET", "path": "/{model_app}/requests/{task_id}/status", "status_path": "status",
                        "running": ["IN_QUEUE", "IN_PROGRESS"], "done": ["COMPLETED"], "failed": [], "error_path": "error"},
               "result": {"via": {"method": "GET", "path": "/{model_app}/requests/{task_id}"},
                          "url_path": "images.0.url", "refused_if_true": "has_nsfw_concepts.0",
                          "refused_reason": "fal's safety checker flagged the image (it is returned blank)"},
               "cancel": {"method": "PUT", "path": "/{model_app}/requests/{task_id}/cancel", "confirm_codes": [200]}},
      "limits": {"prompt_chars": 4000, "timeout_seconds": 60},
      "price": "fal",
      "notes": "Status and result URLs use owner/app only (a sub-path returns 405). X-Fal-No-Retry stops fal re-queuing a billable request. Cancel is confirmed only on 200; 202 means the signal was sent and the job may still complete. Result field names are model-specific; this row fits fal-ai/flux/dev. Prices differ per model and are not tabulated.",
      "sources": [{"url": "https://fal.ai/docs/model-apis/model-endpoints/queue", "read": "2026-11-06"},
                  {"url": "https://docs.openclaw.ai/providers/fal", "read": "2026-11-06"}]
    },
    "fal-video": {
      "provider": "fal", "kind": "video", "protocol": "task", "title": "fal video (queue)",
      "status": "implemented-unverified", "model": "fal-ai/minimax/video-01-live",
      "credential": {"env": "FAL_KEY", "base_url": "https://queue.fal.run"},
      "auth": {"header": "Authorization", "scheme": "Key"},
      "headers": {"X-Fal-No-Retry": "1"},
      "request": {"method": "POST", "path": "/{model}", "body": {"prompt": "{prompt}"}},
      "task": {"id_path": "request_id",
               "poll": {"method": "GET", "path": "/{model_app}/requests/{task_id}/status", "status_path": "status",
                        "running": ["IN_QUEUE", "IN_PROGRESS"], "done": ["COMPLETED"], "failed": [], "error_path": "error"},
               "result": {"via": {"method": "GET", "path": "/{model_app}/requests/{task_id}"}, "url_path": "video.url"},
               "cancel": {"method": "PUT", "path": "/{model_app}/requests/{task_id}/cancel", "confirm_codes": [200]}},
      "limits": {"prompt_chars": 4000, "timeout_seconds": 60},
      "price": "fal",
      "notes": "OpenClaw's default fal video model. Duration and ratio are model-specific and are not sent. Jobs can take many minutes; they resume from the ledger.",
      "sources": [{"url": "https://fal.ai/docs/model-apis/model-endpoints/queue", "read": "2026-11-06"},
                  {"url": "https://docs.openclaw.ai/providers/fal", "read": "2026-11-06"}]
    },
    "pixverse-video": {
      "provider": "pixverse", "kind": "video", "protocol": "task", "title": "PixVerse text to video",
      "status": "implemented-unverified", "model": "v6",
      "credential": {"env": "PIXVERSE_API_KEY", "base_url": "https://app-api.pixverse.ai"},
      "auth": {"header": "API-KEY", "scheme": ""},
      "headers": {"Ai-trace-id": "{uuid}"},
      "request": {"method": "POST", "path": "/openapi/v2/video/text/generate",
                  "body": {"model": "{model}", "prompt": "{prompt}", "duration": "{seconds}",
                           "quality": "{quality}", "aspect_ratio": "{aspect_ratio}"}},
      "task": {"id_path": "Resp.video_id", "envelope": {"code_path": "ErrCode", "ok": 0, "message_path": "ErrMsg"},
               "poll": {"method": "GET", "path": "/openapi/v2/video/result/{task_id}", "status_path": "Resp.status",
                        "running": [5], "done": [1], "failed": [8, 6], "refused": [7]},
               "result": {"url_path": "Resp.url"}},
      "limits": {"prompt_chars": 2048, "seconds": {"min": 1, "max": 15, "default": 5},
                 "aspect_ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "2:3", "3:2", "21:9"], "timeout_seconds": 60},
      "defaults": {"quality": "540p"},
      "price": "pixverse",
      "notes": "Keys are regional (international app-api.pixverse.ai, China app-api.pixverseai.cn); this row is international. A fresh Ai-trace-id per request is required (reusing one blocks a new generation). Status 7 is a content-moderation refusal and credits are refunded. The prompt bound is Hutch's own.",
      "sources": [{"url": "https://docs.platform.pixverse.ai/how-to-get-video-generation-status-882972m0", "read": "2026-11-06"},
                  {"url": "https://docs.openclaw.ai/providers/pixverse", "read": "2026-11-06"}]
    },
    "runway-video": {
      "provider": "runway", "kind": "video", "protocol": "task", "title": "Runway text to video",
      "status": "documented", "model": "gen4.5",
      "credential": {"env": "RUNWAYML_API_SECRET", "base_url": "https://api.dev.runwayml.com"},
      "notes": "Base URL, bearer auth, the X-Runway-Version header (2024-11-06), POST /v1/text_to_video, GET and DELETE /v1/tasks/{id} and the 24 to 48 hour output expiry are read. The request body fields and the status list come from third-party summaries, so the route is not built.",
      "sources": [{"url": "https://docs.dev.runwayml.com/api-details/versioning/", "read": "2026-11-06"},
                  {"url": "https://docs.dev.runwayml.com/assets/outputs/", "read": "2026-11-06"}]
    },
    "elevenlabs-speech": {
      "provider": "elevenlabs", "kind": "audio", "protocol": "sync", "title": "ElevenLabs text to speech",
      "status": "implemented-unverified", "model": "eleven_multilingual_v2",
      "credential": {"env": "ELEVENLABS_API_KEY", "base_url": "https://api.elevenlabs.io"},
      "auth": {"header": "xi-api-key", "scheme": ""},
      "request": {"method": "POST", "path": "/v1/text-to-speech/{voice}",
                  "query": {"output_format": "wav_24000"},
                  "body": {"text": "{prompt}", "model_id": "{model}"}},
      "response": {"kind": "bytes", "accept": ["audio/"]},
      "limits": {"prompt_chars": 4000},
      "defaults": {"voice": "21m00Tcm4TlvDq8ikWAM"},
      "price": "elevenlabs-speech",
      "notes": "The default voice id is ElevenLabs' premade Rachel, recalled and not re-read; pass a voice id from the account's own list. Maximum text length and the quota error shape were not on the page read. Billed per character against the plan.",
      "sources": [{"url": "https://elevenlabs.io/docs/api-reference/text-to-speech/convert", "read": "2026-11-06"}]
    },
    "deepgram-speech": {
      "provider": "deepgram", "kind": "audio", "protocol": "sync", "title": "Deepgram Aura text to speech",
      "status": "implemented-unverified", "model": "aura-2-thalia-en",
      "credential": {"env": "DEEPGRAM_API_KEY", "base_url": "https://api.deepgram.com"},
      "auth": {"header": "Authorization", "scheme": "Token"},
      "request": {"method": "POST", "path": "/v1/speak",
                  "query": {"model": "{voice}", "encoding": "linear16", "container": "wav"},
                  "body": {"text": "{prompt}"}},
      "response": {"kind": "bytes", "accept": ["audio/"]},
      "limits": {"prompt_chars": 2000},
      "defaults": {"voice": "aura-2-thalia-en"},
      "price": "deepgram-speech",
      "notes": "The voice is the model id. 2,000 characters per request (413 beyond, no audio created); 429 means too many in-progress requests for the project, not a price limit.",
      "sources": [{"url": "https://developers.deepgram.com/docs/text-to-speech", "read": "2026-11-06"}]
    }
  }
}
